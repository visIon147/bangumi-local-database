# Copy this file to .env and fill credentials locally or from the UI settings page.
# Never commit .env or a real access token.
BANGUMI_ACCESS_TOKEN=
BANGUMI_USERNAME=
BANGUMI_USER_AGENT=
BLD_BANGUMI_WEB_BASE_URL=https://bgm.tv
BLD_STEAM_ROOT=
BLD_STEAM_ACCOUNT_ID=
BLD_STEAM_CONFIG=config/steam.toml
BLD_STEAM_ID64=
STEAM_WEB_API_KEY=

# Optional overrides
# BANGUMI_BASE_URL=https://api.bgm.tv
# BANGUMI_REQUEST_TIMEOUT_SECONDS=20
# BLD_DATABASE_URL=sqlite:///./data/gamevault.db
# BLD_PLAN_DIRECTORY=plans
# BLD_BACKUP_DIRECTORY=backups
# BLD_MEDIA_CACHE_DIRECTORY=data/media-cache
# BLD_IMAGE_POLICY=metadata
# BLD_IMAGE_MAX_ITEM_BYTES=10485760
# BLD_IMAGE_CACHE_MAX_BYTES=2147483648
# Legacy BGV_DATABASE_URL / BGV_PLAN_DIRECTORY / BGV_BACKUP_DIRECTORY remain accepted.
# Image policy: none=skip image metadata, metadata=store remote references only,
# cache=download validated images into the private content-addressed cache.
# BANGUMI_WRITE_DELAY_MS=500
# BANGUMI_MAX_RETRIES=4
# BANGUMI_RETRY_BASE_SECONDS=0.5
